<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\cities.osm" />
    <None Remove="Data\countries_rdp_0_02.geojson" />
    <None Remove="Data\countries_vw_0_05.geojson" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\cities.osm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\countries_rdp_0_02.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\countries_vw_0_05.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\ne_50m_admin_0_countries.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldMap.Core\WorldMap.Core.csproj" />
    <ProjectReference Include="..\WorldMap.Infrastructure\WorldMap.Infrastructure.csproj" />
  </ItemGroup>

</Project>
