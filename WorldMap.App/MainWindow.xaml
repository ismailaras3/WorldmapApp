<Window x:Class="WorldMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interactive World Map"
        Width="1400"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="Gray"
                Padding="8">

            <DockPanel>

                <StackPanel Orientation="Horizontal">

                    <!-- Projectie kiezen -->
                    <TextBlock Text="Projectie:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="ProjectionComboBox"
                              Width="200"
                              Height="30"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"
                              ItemsSource="{Binding Projections}"
                              SelectedItem="{Binding SelectedProjection}"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProjectionComboBox_SelectionChanged"/>

                    <!-- Dataset kiezen -->
                    <TextBlock Text="Dataset:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="DatasetComboBox"
                              Width="180"
                              Height="30"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"
                              ItemsSource="{Binding Datasets}"
                              SelectedItem="{Binding SelectedDataset}"
                              DisplayMemberPath="Name"
                              SelectionChanged="DatasetComboBox_SelectionChanged"/>
                    <TextBlock Text="Continent:"
           VerticalAlignment="Center"
           Margin="0,0,6,0"/>

                    <ComboBox x:Name="ContinentComboBox"
          Width="150"
          Height="30"
          VerticalAlignment="Center"
          Margin="0,0,20,0"
          ItemsSource="{Binding Continents}"
          SelectedItem="{Binding SelectedContinent}"
          SelectionChanged="ContinentComboBox_SelectionChanged"/>

                    <!-- Datum voor de zonneberekening -->
                    <TextBlock Text="Datum:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <DatePicker x:Name="SolarDatePicker"
            Width="140"
            Height="30"
            VerticalAlignment="Center"
            Margin="0,0,20,0"
            SelectedDate="{Binding SelectedDate}"
            SelectedDateChanged="SolarDatePicker_SelectedDateChanged"/>

                    <!-- Welke zonneparameter willen we tonen? -->
                    <TextBlock Text="Parameter:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="SolarParameterComboBox"
                              Width="150"
                              Height="30"
                              VerticalAlignment="Center"
                              Margin="0,0,20,0"
                              ItemsSource="{Binding SolarParameters}"
                              SelectedItem="{Binding SelectedSolarParameter}"/>

                    <Button x:Name="CalculateSolarMapButton"
        Content="Bereken kaart"
        Height="30"
        Padding="12,0"
        Margin="0,0,20,0"
        Click="CalculateSolarMapButton_Click"/>
                    <TextBlock Text="Tijd:"
           VerticalAlignment="Center"
           Margin="15,0,5,0"/>

                    <Slider x:Name="DaylightTimeSlider"
        Width="180"
        Minimum="0"
        Maximum="1439"
        TickFrequency="30"
        IsSnapToTickEnabled="True"
        Value="{Binding DaylightTimeMinutes}"
        ValueChanged="DaylightTimeSlider_ValueChanged"/>

                    <TextBlock Text="{Binding DaylightTimeText}"
           Width="75"
           VerticalAlignment="Center"
           Margin="8,0,8,0"/>

                    <Button x:Name="CalculateDaylightMapButton"
        Content="Daglichtkaart"
        Height="30"
        Padding="10,0"
        Click="CalculateDaylightMapButton_Click"/>

                    <!-- Info over de gekozen GeoJSON-dataset -->
                    <TextBlock Text="{Binding DatasetInfoText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Kaart -->
        <Grid x:Name="MapViewport"
              Grid.Row="1"
              Background="LightGray"
              ClipToBounds="True">

            <!-- Gewone wereldkaart -->
            <Canvas x:Name="MapCanvas"
                    Background="AliceBlue"/>

            <!--
                Bitmaplaag voor opdracht 2.
                Hier komen later:
                - daglengte
                - solar noon
                - zonsopgang
                - zonsondergang
                - daglichtkaart
            -->
            <Image x:Name="SolarOverlay"
                   Stretch="Fill"
                   IsHitTestVisible="False"
                   Opacity="0.75"/>

            <!-- Informatievak rechtsboven -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="8"
                    Background="#CCFFFFFF"
                    CornerRadius="4">

                <StackPanel>

                    <TextBlock Text="Wereldkaart"
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ZoomText}"/>

                    <TextBlock Text="{Binding CountryCountText}"/>

                    <Separator Margin="0,5,0,5"/>

                    <TextBlock Text="{Binding ColorScaleTitle}"
           FontWeight="Bold"/>

                    <TextBlock Text="{Binding ColorScaleText}"
               Margin="0,2,0,4"/>

                    <!-- Eenvoudige visuele kleurenschaal -->
                    <Border Width="180"
            Height="18"
            BorderBrush="Gray"
            BorderThickness="1">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5"
                                 EndPoint="1,0.5">

                                <GradientStop Color="Blue"
                              Offset="0"/>

                                <GradientStop Color="Khaki"
                              Offset="0.5"/>

                                <GradientStop Color="Gold"
                              Offset="1"/>

                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Statusbar -->
        <StatusBar Grid.Row="2">

            <StatusBarItem>
                <TextBlock Text="{Binding CoordinateText}"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding SolarValueText}"
                   FontWeight="SemiBold"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding RenderTimeText}"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding LoadTimeText}"/>
            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>