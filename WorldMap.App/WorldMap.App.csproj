    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\ne_50m_admin_0_countries.geojson" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\cities.osm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\countries_rdp_0_02.geojson">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\countries_vw_0_05.geojson">
